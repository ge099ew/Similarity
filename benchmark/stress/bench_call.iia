Explanation[Application{Benchmark(type:stress_call)}]

Function[inc{
  receive{int(x)},
  return(+{int(x,1)})
}]

Function_public[main{
  receive{},
  Variable[let{int(v:0)}],
  Variable[let{int(i:0)}],
  Loop[
    check{less(i:1000000)},
    for{
      Mutation[variable{int(v:call{inc(v)})}],
      ++{i}
    }
  ],
  return(v)
}]
