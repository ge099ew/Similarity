Explanation[Application{Benchmark(type:nested_loop)}]

Function_public[main{
  receive{},
  Variable[let{int(i:0)}],
  Variable[let{int(j:0)}],
  Variable[let{int(count:0)}],
  Loop[
    check{less(i:1000)},
    for{
      Mutation[variable{int(j:0)}],
      Loop[
        check{less(j:1000)},
        for{
          Mutation[variable{int(count:+{int(count,1)})}],
          ++{j}
        }
      ],
      ++{i}
    }
  ],
  return(count)
}]
